# Copy the values you need into .env.local (gitignored; overrides the tracked .env).
# Vite only exposes variables prefixed with VITE_ to the client.
# Note: .env is committed by Lovable and holds only publishable Supabase values.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# src/supabase.js also accepts the legacy name:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog (Project Settings → Project API Key; US Cloud)
VITE_POSTHOG_KEY=phc_your-project-api-key
VITE_POSTHOG_HOST=https://us.i.posthog.com
