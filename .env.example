# Copy the values you need into .env / .env.local (both gitignored).
# Vite only exposes variables prefixed with VITE_ to the client.

# Supabase (Project Settings → API) — goes in .env.local
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog (Project Settings → Project API Key; US Cloud) — goes in .env
VITE_POSTHOG_KEY=phc_your-project-api-key
VITE_POSTHOG_HOST=https://us.i.posthog.com
